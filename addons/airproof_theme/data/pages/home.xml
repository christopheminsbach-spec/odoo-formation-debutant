<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="airproof_homepage" model="website.page">

    <field name="name">Airproof Homepage</field>

    <field name="url">/airproof_homepage</field>

    <field name="key">airproof_homepage</field>

    <field name="is_published">True</field>

    <field name="arch" type="xml">

        <t t-call="website.layout">

            <div id="wrap">

                <section class="airproof-hero">

                <div class="airproof-overlay"></div>

                <div class="container">
                  <div class="airproof-content">

                   <img class="airproof-logo"/>

                   <h1>
                    La qualité de l’air intelligent
                   </h1>

                   <p>
                     Solutions professionnelles de ventilation,
                     climatisation et supervision IoT.
                   </p>

                   <a class="btn btn-primary">
                      Découvrir nos solutions
                   </a>

                  </div>
                  </div>

                </section>

            </div>

        </t>

    </field>

</record>


</odoo>